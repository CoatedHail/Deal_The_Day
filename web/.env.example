# Template for web/.env.local — copy this file, fill in real values.
# Never commit the filled-in version; web/.gitignore ignores .env* except this
# template.

# Neon connection string.
# Neon dashboard → Connect your app manually → Connection string.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Google OAuth client, for "Sign in with Google".
# console.cloud.google.com → Google Auth Platform → Clients → Web application.
# Authorised redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://deal-the-day.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Signs session cookies. Generate with: openssl rand -base64 33
AUTH_SECRET=

# The app's own base URL. Vercel sets this automatically in production.
AUTH_URL=http://localhost:3000
